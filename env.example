# 로컬 실행용 예시. 실제 값은 Render 환경변수에 넣고, 이 파일을 .env로 복사해 값을 채운 것은 절대 커밋하지 마세요.
SECRET_KEY=여기에-길고-무작위인-문자열
SETUP_CODE=처음-비밀번호-정할-때-입력할-코드
LIFEOS_GITHUB_REPO=내아이디/life-os
LIFEOS_GITHUB_TOKEN=github_pat_xxxxxxxx
LIFEOS_DATA_BRANCH=lifeos-data
DATA_ENCRYPTION_KEY=잊어버리지-않을-긴-문장
# 아래는 로컬 개발에서만
LIFEOS_LOCAL_DIR=./.lifeos-data
LIFEOS_INSECURE_COOKIE=1
